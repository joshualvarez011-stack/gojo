RESTAURANT_SLUG=gojo
LOCATION_SLUG=stockholm
# Netlify Database injects NETLIFY_DB_URL automatically when provisioned.
# Admin credentials are server-side only.
GOJO_ADMIN_PASSWORD_HASH=scrypt$<salt-hex>$<hash-hex>
GOJO_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional when notifications are activated later:
RESEND_API_KEY=
GOJO_EMAIL_FROM=GOJO <bokning@your-verified-domain.se>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
GOJO_AI_TOOL_SECRET=replace-with-a-long-random-secret
